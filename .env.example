# ========================================================
# CLEANLOOP - Environment Configuration Template
# Copy this file to .env or export these variables in your system.
# DO NOT commit real secrets to source control.
# ========================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cleanloop_db
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JWT Security Configuration
# The secret must be at least 256 bits (32+ characters) for HS256
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_min_256_bits
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS / Frontend Integration
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=15MB

# AI Waste Classification Service (Python FastAPI)
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_ENABLED=true
AI_SERVICE_TIMEOUT_SECONDS=10

# External Maps Integration (Google Maps Platform)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Mail / Notifications (Optional Provider)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=no-reply@cleanloop.org
